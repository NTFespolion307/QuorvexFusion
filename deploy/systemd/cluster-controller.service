# Installed by install.sh, which replaces @BIN@, @DATA_DIR@ and @USER@.
[Unit]
Description=QuorvexFusion cluster controller
Documentation=https://github.com/NTFespolion307/QuorvexFusion
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
Group=@USER@
ExecStart=@BIN@ controller --data-dir @DATA_DIR@
Restart=always
RestartSec=3
LimitNOFILE=65536

# Hardening: the controller only needs its data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@DATA_DIR@

[Install]
WantedBy=multi-user.target
